+# Let's Encrypt для домена через acme.sh: проверка по HTTP на порту 80 (сам acme.sh,
+# без веб-сервера), продление — его же cron. После продления перечитываем сертификат.
+issue_domain_cert() {
+  local ip resolved log=/var/log/kit-acme.log rc=0
+  ip=$(public_ip)
+  resolved=$(getent ahostsv4 "$DOMAIN" 2>/dev/null | awk 'NR==1 {print $1}') || true
+  [[ -n $resolved ]] || die "Домен $DOMAIN не найден в DNS. Создайте A-запись на $ip (DNS only) и подождите пару минут."
+  [[ $resolved == "$ip" ]] || die "Домен $DOMAIN указывает на $resolved, а IP сервера $ip. Исправьте A-запись (DNS only, без прокси Cloudflare)."
+  if [[ ! -x $ACME ]]; then
+    say "Ставлю acme.sh"
+    curl -fsSL https://get.acme.sh | sh -s >"$log" 2>&1 || die "acme.sh не установился. Лог: $log"
+  fi
+  say "Выпускаю сертификат Let's Encrypt для ${B}$DOMAIN${N}"
+  "$ACME" --set-default-ca --server letsencrypt >>"$log" 2>&1
+  "$ACME" --issue -d "$DOMAIN" --standalone --keylength ec-256 >>"$log" 2>&1 || rc=$?
+  # 2 — сертификат уже есть и ещё действует.
+  ((rc == 0 || rc == 2)) || die "Let's Encrypt не выдал сертификат. Проверьте, что порт 80/tcp открыт у хостера. Лог: $log"
+  install -d -m 700 "$CERT_DIR"
+  "$ACME" --install-cert -d "$DOMAIN" --ecc \
+    --fullchain-file "$CERT_DIR/fullchain.pem" --key-file "$CERT_DIR/privkey.pem" \
+    --reloadcmd "systemctl reload nginx 2>/dev/null; systemctl restart x-ui 2>/dev/null; true" >>"$log" 2>&1 \
+    || die "Не удалось установить сертификат. Лог: $log"
+}
